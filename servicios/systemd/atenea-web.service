[Unit]
Description=Atenea web
After=network-online.target ornith.service
Wants=network-online.target

[Service]
User=sergio
Group=sergio
SupplementaryGroups=video render
WorkingDirectory=/mnt/models/atenea
ExecStart=/mnt/models/atenea/.venv/bin/python -m atenea.app.web
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
