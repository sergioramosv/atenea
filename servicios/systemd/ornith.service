[Unit]
Description=Ornith-1.5-35B-A3B (llama.cpp) para Claude Code local
After=network-online.target
Wants=network-online.target

[Service]
User=sergio
Group=render
SupplementaryGroups=video render
Environment=LLAMA_ARG_THINK_BUDGET=8000
EnvironmentFile=/etc/atenea/ornith.env
ExecStart=/mnt/models/llamacpp/b12242-vulkan/llama-b12242/llama-server \
  -m /mnt/models/gguf/Ornith-1.5-35B-A3B-Q4_K_M.gguf -ngl 99 -fa on \
  -c 614400 -np 3 -kvu -ctk q8_0 -ctv q8_0 -ub 2048 \
  --spec-type draft-mtp,ngram-mod --spec-draft-n-max 1 \
  --temp 1.0 --top-p 0.95 --top-k 20 --jinja \
  --host 0.0.0.0 --port 8080 --alias ornith --cache-ram 16384 --cache-reuse 256 --slot-save-path /mnt/models/llamacpp/slots
WorkingDirectory=/mnt/models/llamacpp/b12242-vulkan/llama-b12242
Restart=on-failure
RestartSec=10
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
